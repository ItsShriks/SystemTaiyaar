alias mjpython='$HOME/Library/Python/3.9/bin/mjpython'

# macOS System & Network
alias myip="ifconfig | grep 'inet ' | grep -v 127.0.0.1 | awk '{print \$2}'"
alias pubip="curl -s https://icanhazip.com"
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
alias afk="pmset displaysleepnow"

# Local Server & Clipboard
alias serve="python3 -m http.server 8000"
alias clip="pbcopy <"              # Usage: clip file.txt
alias paste="pbpaste"              # Outputs clipboard text to stdout
alias beast="vncviewer shrikar22"

# Shared by serveqr and receiveqr: checks the network and port, then prints
# the address and its QR code. Usage: _lan_qr <port> <path>
_lan_qr() {
  local port="$1" ip
  ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en8 2>/dev/null)
  if [[ -z "$ip" ]]; then
    echo "Not connected to Wi-Fi or Ethernet" >&2
    return 1
  fi
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port $port is already in use, pass another one (e.g. $((port + 1)))" >&2
    return 1
  fi
  local url="http://$ip:$port$2"
  echo "$url"
  if command -v qrencode >/dev/null; then
    qrencode -t ANSIUTF8 -m 2 "$url"
  else
    echo "(brew install qrencode to get a QR code here)"
  fi
  echo "Ctrl+C to stop"
}

# Share this folder on your Wi-Fi: scan the QR code to open it on your phone
# Anyone on the same network can see the folder while it runs
# Usage: serveqr [port]   (default 8000)
serveqr() {
  local port="${1:-8000}"
  echo "Sharing ${PWD/#$HOME/~} at:"
  _lan_qr "$port" / || return 1
  python3 -m http.server "$port"
}

# Receive files from a phone (Android, iPhone, any browser) into this folder:
# scan the QR code, pick files, tap Upload
# Anyone on the same network can upload, and see the folder, while it runs
# Usage: receiveqr [port]   (default 8000)
receiveqr() {
  local port="${1:-8000}"
  if ! command -v uvx >/dev/null; then
    echo "receiveqr: needs uv, run: brew install uv" >&2
    return 1
  fi
  echo "Uploads will be saved in ${PWD/#$HOME/~}. Open:"
  _lan_qr "$port" /upload || return 1
  # Pinned; uv keeps it in its own cache, separate from conda and pixi
  uvx uploadserver@6.0.5 "$port"
}


