alias gp="git push"
alias gs="git status"
alias gundo="git reset --soft HEAD~1"
alias glog="git log --graph --oneline --decorate --all"
alias gpull="git pull --recurse-submodules"

# alias git-back="~/git-commit-date-changer"


# ================================
# 🔧 Functions
# ================================

# Smart Git Commit (No quotes required!)
# Usage: gcm updated sub-node parameters
gcm() {
  git add . && git commit -m "$*"
}

# Web Search
# Usage: google ros2 humble launch files
google() {
  open "https://www.google.com/search?q=$*"
}

# Create a directory and enter it immediately
# Usage: mkcd my_new_folder
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Universal Extractor
# Usage: extract archive.tar.gz
extract() {
  if [ -f "$1" ] ; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.bz2)       bunzip2 "$1"    ;;
      *.rar)       unrar e "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xvf "$1"     ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1" ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Process Termination: lists what matches the name, asks, then sends TERM
# Usage: fnamekill python      (fnamekill -9 python to force-kill)
fnamekill() {
  local sig=TERM
  [[ "$1" == -9 ]] && { sig=KILL; shift; }
  if [[ -z "$1" ]]; then
    echo "Usage: fnamekill [-9] <process name>" >&2
    return 1
  fi
  # Matches process names only (not full command lines), never this shell
  local matches
  matches=$(pgrep -il -- "$1" | grep -v "^$$ ")
  if [[ -z "$matches" ]]; then
    echo "fnamekill: no process named like '$1'" >&2
    return 1
  fi
  echo "$matches"
  read -q -u 0 "?Send $sig to these? (y/N) " || { echo; return 1; }
  echo
  echo "$matches" | awk '{print $1}' | xargs kill -s "$sig"
}

# Open this repo's web page (GitHub, GitLab, ...); outside a repo, your GitHub
# Usage: gopen
gopen() {
  local url
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      #url=""
    echo "ADD YOUR URL in $HOME/SystemTaiyaar/rc files/.zsh_aliases"
  else
    url=$(git remote get-url origin 2>/dev/null || git remote get-url "$(git remote | head -1)" 2>/dev/null)
    if [[ -z "$url" ]]; then
      echo "gopen: this repo has no remote" >&2
      return 1
    fi
    # git@github.com:user/repo.git or ssh://git@host/user/repo -> https://host/user/repo
    url=${url%.git}
    url=$(sed -E 's#^(ssh://)?git@([^:/]+)[:/]#https://\2/#; s#^https://[^@/]+@#https://#' <<< "$url")
  fi
  echo "Opening $url"
  open "$url"
}

# Change the date/time of the LAST commit
# Usage: git-back "2026-08-01 14:00:00"
git-back() {
  if [ -z "$1" ]; then
    echo "Usage: git-back \"YYYY-MM-DD HH:MM:SS\""
    return 1
  fi
  GIT_COMMITTER_DATE="$1" git commit --amend --no-edit --date "$1"
}

# Copy the absolute path of a file (or the current directory) to the clipboard
# Usage: cpath [file]
cpath() {
  local target="${1:-.}"

  if [[ ! -e "$target" ]]; then
    echo "cpath: no such file or directory: $target" >&2
    return 1
  fi

  local full="${target:A}"   # zsh modifier: absolute path, symlinks resolved

  if command -v pbcopy >/dev/null; then
    print -rn -- "$full" | pbcopy                        # macOS
  elif command -v wl-copy >/dev/null; then
    print -rn -- "$full" | wl-copy                       # Wayland
  elif command -v xclip >/dev/null; then
    print -rn -- "$full" | xclip -selection clipboard    # X11
  elif command -v xsel >/dev/null; then
    print -rn -- "$full" | xsel --clipboard --input      # X11 alt
  elif command -v clip.exe >/dev/null; then
    print -rn -- "$full" | clip.exe                      # WSL
  else
    echo "cpath: no clipboard tool found (install xclip or wl-clipboard)" >&2
    return 1
  fi

  echo "Copied: $full"
}
